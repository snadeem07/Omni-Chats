# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google (Gemini) ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Alibaba (Qwen / DashScope) ────────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-...

# ── Model versions (change here to change everywhere) ────────────────────────
# Claude options : claude-opus-4-5 | claude-sonnet-4-5 | claude-haiku-4-5
CLAUDE_MODEL=claude-opus-4-5

# Gemini options : gemini-2.0-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Qwen options   : qwen-plus | qwen-turbo | qwen-max
QWEN_MODEL=qwen-plus

# ── Parallel mode rounds (1–3) ───────────────────────────────────────────────
MAX_ROUNDS=2

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
