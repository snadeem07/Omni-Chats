# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google (Gemini) ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── Alibaba (Qwen / DashScope) ────────────────────────────────────────────────
DASHSCOPE_API_KEY=sk-...

# ── Model versions (change here to change everywhere) ────────────────────────
# Claude options : claude-opus-4-5 | claude-sonnet-4-5 | claude-haiku-4-5
CLAUDE_MODEL=claude-haiku-4-5

# Gemini options : gemini-2.5-flash-preview-05-20 | gemini-2.5-flash-lite-preview-06-17 | gemini-2.5-pro-preview-05-06 | gemini-2.0-flash-001 | gemini-2.0-flash-lite-001 | gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Qwen options   : qwen3-235b-a22b | qwen3-235b-a22b-instruct-2507 | qwen3-32b | qwen3-14b | qwen3-8b | qwen3-0.6b | qwen3-30b-a3b | qwen3-30b-a3b-instruct-2507
QWEN_MODEL=qwen3-32b

# ── Parallel mode rounds (1–3) ───────────────────────────────────────────────
MAX_ROUNDS=2

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
